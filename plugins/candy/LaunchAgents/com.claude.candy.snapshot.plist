<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.claude.candy.snapshot</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/sh</string>
        <string>-c</string>
        <string>exec "${JOBS_ROOT:-$HOME/jobs}/bin/usage_snapshot.sh"</string>
    </array>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>1</integer><key>Minute</key><integer>58</integer></dict>
        <dict><key>Hour</key><integer>10</integer><key>Minute</key><integer>58</integer></dict>
        <dict><key>Hour</key><integer>15</integer><key>Minute</key><integer>58</integer></dict>
        <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>58</integer></dict>
    </array>
</dict>
</plist>
